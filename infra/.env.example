# Copy to infra/.env and fill in. Never commit the real .env.
# Generate random values with:  python -m app.cli gen-key   (or: openssl rand -base64 32)

DOMAIN=kampungadem.my.id
CHIRPSTACK_DOMAIN=lns.kampungadem.my.id

# Database
POSTGRES_PASSWORD=
CHIRPSTACK_DB_PASSWORD=

# ChirpStack + MQTT (create users in infra/mosquitto/passwd, see docs/deploy.md)
CHIRPSTACK_API_SECRET=
MQTT_CHIRPSTACK_PASSWORD=
MQTT_USERNAME=ingest
MQTT_PASSWORD=
MQTT_BRIDGE_USERNAME=bridge
MQTT_BRIDGE_PASSWORD=

# Backend auth
JWT_SECRET=
CORS_ORIGINS=["https://kampungadem.my.id"]
COOKIE_SECURE=true

# Phone number protection: two different 32-byte keys, base64
PHONE_ENC_KEY=
PHONE_HASH_KEY=

# HTTP ingest (POST /api/v1/sensors/readings), header X-API-Key
INGEST_API_KEY=

# WhatsApp Cloud API (Meta). Keep WA_ENABLED=false until templates are approved.
WA_ENABLED=false
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Google Earth Engine (optional; satellite job is skipped when empty)
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=/secrets/gee-key.json
GEE_RW_ASSET=

# Backup (infra/backup/backup.sh)
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE=
